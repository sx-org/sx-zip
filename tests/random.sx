#import "modules/std.sx";
mz :: #import "../miniz.sx";

SIZES : [22]i64 : .[0, 1, 2, 3, 4, 7, 8, 15, 16, 31, 32, 255, 256, 257, 258, 259, 1024, 32767, 32768, 32769, 65535, 65536];

check_roundtrip :: (plain: string, level: i64, alloc: Allocator) -> bool {
    packed := mz.deflate(plain, level, alloc);
    out := mz.inflate(packed, plain.len, alloc) catch (e) {
        print("random roundtrip inflate failed size={} level={} packed={} error={}\n", plain.len, level, packed.len, e);
        alloc.dealloc_bytes(packed.ptr);
        return false;
    };
    ok := mz.bytes_equal(plain, out);
    if !ok { print("random roundtrip mismatch size={} level={} packed={} output={}\n", plain.len, level, packed.len, out.len); }
    if out.ptr != null { alloc.dealloc_bytes(out.ptr); }
    alloc.dealloc_bytes(packed.ptr);
    ok
}

main :: () -> i32 {
    gpa := mem.GPA.init();
    raw := gpa.alloc_bytes(65536);
    data := string.{ ptr = xx raw, len = 65536 };

    // Deterministic high-entropy-ish corpus.
    state := 0x12345678;
    i := 0;
    while i < data.len {
        state = (state ^ (state << 13)) & 0xffffffff;
        state = state ^ (state >> 17);
        state = (state ^ (state << 5)) & 0xffffffff;
        data.ptr[i] = (state & 0xff).(u8);
        i += 1;
    }
    si := 0;
    while si < SIZES.len {
        view := string.{ ptr = data.ptr, len = SIZES[si] };
        if !check_roundtrip(view, 0, gpa) or !check_roundtrip(view, 1, gpa) or !check_roundtrip(view, 6, gpa) or !check_roundtrip(view, 9, gpa) {
            gpa.dealloc_bytes(raw);
            return 1;
        }
        si += 1;
    }

    // tdefl must abandon a compressed candidate when it expands. This guards
    // the adaptive stored-block fallback that the old fixed-only encoder did
    // not have (allowing room for several bounded raw blocks).
    entropy := string.{ ptr = data.ptr, len = data.len };
    level := 1;
    while level <= 9 {
        packed := mz.deflate(entropy, level, gpa);
        if packed.len > entropy.len + 64 {
            gpa.dealloc_bytes(packed.ptr);
            gpa.dealloc_bytes(raw);
            return 1;
        }
        gpa.dealloc_bytes(packed.ptr);
        if level == 1 { level = 6; }
        else if level == 6 { level = 9; }
        else { level = 10; }
    }

    // Highly repetitive corpus drives long matches and lazy chain reuse.
    i = 0;
    while i < data.len { data.ptr[i] = ('a' + ((i / 97 + i) % 11)).(u8); i += 1; }
    si = 0;
    while si < SIZES.len {
        view := string.{ ptr = data.ptr, len = SIZES[si] };
        if !check_roundtrip(view, 1, gpa) or !check_roundtrip(view, 6, gpa) or !check_roundtrip(view, 9, gpa) {
            gpa.dealloc_bytes(raw);
            return 1;
        }
        si += 1;
    }

    // A skewed 10-symbol corpus should make the dynamic alphabet smaller than
    // fixed Huffman and therefore exercise the BTYPE=10 encoder path.
    state = 0x31415926;
    i = 0;
    while i < 5000 {
        state = (state ^ (state << 13)) & 0xffffffff;
        state = state ^ (state >> 17);
        state = (state ^ (state << 5)) & 0xffffffff;
        data.ptr[i] = ('A' + (state % 10)).(u8);
        i += 1;
    }
    skew := string.{ ptr = data.ptr, len = 5000 };
    dynamic := mz.deflate(skew, 9, gpa);
    if ((dynamic[0] >> 1) & 3) != 2 {
        gpa.dealloc_bytes(dynamic.ptr);
        gpa.dealloc_bytes(raw);
        return 1;
    }
    decoded := mz.inflate(dynamic, skew.len, gpa) catch (e) {
        gpa.dealloc_bytes(dynamic.ptr);
        gpa.dealloc_bytes(raw);
        return 1;
    };
    dynamic_ok := mz.bytes_equal(decoded, skew);
    gpa.dealloc_bytes(decoded.ptr);
    gpa.dealloc_bytes(dynamic.ptr);
    if !dynamic_ok { gpa.dealloc_bytes(raw); return 1; }

    // Repetition crossing many caller chunks must continue to use the same
    // rolling dictionary instead of restarting an independent block matcher.
    i = 20000;
    while i < data.len { data.ptr[i] = data[i % 20000]; i += 1; }
    cross := mz.deflate(data, 9, gpa);
    if cross.len >= 25000 {
        gpa.dealloc_bytes(cross.ptr);
        gpa.dealloc_bytes(raw);
        return 1;
    }
    cross_plain := mz.inflate(cross, data.len, gpa) catch (e) {
        gpa.dealloc_bytes(cross.ptr);
        gpa.dealloc_bytes(raw);
        return 1;
    };
    cross_ok := mz.bytes_equal(cross_plain, data);
    gpa.dealloc_bytes(cross_plain.ptr);
    gpa.dealloc_bytes(cross.ptr);
    if !cross_ok { gpa.dealloc_bytes(raw); return 1; }

    gpa.dealloc_bytes(raw);
    if gpa.alloc_count != 0 { print("random leaked allocations: {}\n", gpa.alloc_count); return 1; }
    print("random corpus ok\n");
    0
}
