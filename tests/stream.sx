#import "modules/std.sx";
mz :: #import "../miniz.sx";

drive_chunks :: (packed: string, plain: string, input_chunk: i64, output_chunk: i64, alloc: Allocator) -> bool {
    state := mz.Inflater.init(plain.len, alloc);
    raw := alloc.alloc_bytes(plain.len);
    out := string.{ ptr = xx raw, len = plain.len };
    input_at := 0;
    input_limit := input_chunk;
    if input_limit > packed.len { input_limit = packed.len; }
    output_at := 0;
    turns := 0;
    while turns < packed.len * 8 + plain.len * 4 + 100 {
        input_view : string = .{ ptr = null, len = 0 };
        if input_at < input_limit { input_view = string.{ ptr = @packed.ptr[input_at], len = input_limit - input_at }; }
        available_out := plain.len - output_at;
        if available_out > output_chunk { available_out = output_chunk; }
        output_view : string = .{ ptr = null, len = 0 };
        if available_out > 0 { output_view = string.{ ptr = @out.ptr[output_at], len = available_out }; }

        progress := state.step(input_view, output_view) catch (e) {
            state.deinit();
            if raw != null { alloc.dealloc_bytes(raw); }
            return false;
        };
        input_at += progress.consumed;
        output_at += progress.produced;
        if progress.status == .done {
            ended := true;
            state.end() catch (e) { ended = false; };
            ok := ended and input_at == packed.len and output_at == plain.len and mz.bytes_equal(out, plain);
            state.deinit();
            if raw != null { alloc.dealloc_bytes(raw); }
            return ok;
        }
        if progress.status == .need_input {
            if input_at != input_limit or input_limit >= packed.len {
                state.deinit();
                if raw != null { alloc.dealloc_bytes(raw); }
                return false;
            }
            input_limit += input_chunk;
            if input_limit > packed.len { input_limit = packed.len; }
        }
        if progress.status == .need_output and output_at >= plain.len {
            state.deinit();
            if raw != null { alloc.dealloc_bytes(raw); }
            return false;
        }
        turns += 1;
    }
    state.deinit();
    if raw != null { alloc.dealloc_bytes(raw); }
    false
}

drive_split :: (packed: string, plain: string, split: i64, alloc: Allocator) -> bool {
    state := mz.Inflater.init(plain.len, alloc);
    raw := alloc.alloc_bytes(plain.len);
    out := string.{ ptr = xx raw, len = plain.len };
    input_at := 0;
    input_limit := split;
    second := false;
    output_at := 0;
    turns := 0;
    while turns < packed.len * 8 + plain.len * 4 + 100 {
        input_view : string = .{ ptr = null, len = 0 };
        if input_at < input_limit { input_view = string.{ ptr = @packed.ptr[input_at], len = input_limit - input_at }; }
        output_view : string = .{ ptr = null, len = 0 };
        if output_at < plain.len { output_view = string.{ ptr = @out.ptr[output_at], len = 1 }; }
        progress := state.step(input_view, output_view) catch (e) {
            state.deinit();
            if raw != null { alloc.dealloc_bytes(raw); }
            return false;
        };
        input_at += progress.consumed;
        output_at += progress.produced;
        if progress.status == .done {
            ok := input_at == packed.len and output_at == plain.len and mz.bytes_equal(out, plain);
            state.deinit();
            if raw != null { alloc.dealloc_bytes(raw); }
            return ok;
        }
        if progress.status == .need_input {
            if input_at != input_limit { state.deinit(); if raw != null { alloc.dealloc_bytes(raw); } return false; }
            if !second { input_limit = packed.len; second = true; }
            else { state.deinit(); if raw != null { alloc.dealloc_bytes(raw); } return false; }
        }
        if progress.status == .need_output and output_at >= plain.len {
            state.deinit();
            if raw != null { alloc.dealloc_bytes(raw); }
            return false;
        }
        turns += 1;
    }
    state.deinit();
    if raw != null { alloc.dealloc_bytes(raw); }
    false
}

drive_zlib :: (packed: string, plain: string, alloc: Allocator) -> bool {
    state := mz.ZlibInflater.init(plain.len, alloc);
    defer state.deinit();
    raw := alloc.alloc_bytes(plain.len);
    out := string.{ ptr = xx raw, len = plain.len };
    input_at := 0;
    output_at := 0;
    turns := 0;
    while turns < packed.len * 8 + plain.len * 4 + 100 {
        in_len := if input_at < packed.len then 1 else 0;
        input : string = .{ ptr = null, len = 0 };
        if in_len > 0 { input = string.{ ptr = @packed.ptr[input_at], len = 1 }; }
        out_len := if output_at < plain.len then 1 else 0;
        output : string = .{ ptr = null, len = 0 };
        if out_len > 0 { output = string.{ ptr = @out.ptr[output_at], len = 1 }; }
        progress := state.step(input, output) catch (e) {
            if raw != null { alloc.dealloc_bytes(raw); }
            return false;
        };
        input_at += progress.consumed;
        output_at += progress.produced;
        if progress.status == .done {
            ok := input_at == packed.len and output_at == plain.len and mz.bytes_equal(out, plain);
            state.deinit();
            if raw != null { alloc.dealloc_bytes(raw); }
            return ok;
        }
        if progress.status == .need_input and input_at >= packed.len {
            if raw != null { alloc.dealloc_bytes(raw); }
            return false;
        }
        if progress.status == .need_output and output_at >= plain.len {
            if raw != null { alloc.dealloc_bytes(raw); }
            return false;
        }
        turns += 1;
    }
    if raw != null { alloc.dealloc_bytes(raw); }
    false
}

drive_stored_deflater :: (plain: string, expected: string, input_chunk: i64, output_chunk: i64, alloc: Allocator) -> bool {
    state := mz.StoredDeflater.init(alloc);
    raw := alloc.alloc_bytes(expected.len);
    out := string.{ ptr = xx raw, len = expected.len };
    input_at := 0;
    input_limit := input_chunk;
    if input_limit > plain.len { input_limit = plain.len; }
    output_at := 0;
    turns := 0;
    while turns < plain.len * 4 + expected.len * 4 + 100 {
        input : string = .{ ptr = null, len = 0 };
        if input_at < input_limit { input = string.{ ptr = @plain.ptr[input_at], len = input_limit - input_at }; }
        available_out := expected.len - output_at;
        if available_out > output_chunk { available_out = output_chunk; }
        output : string = .{ ptr = null, len = 0 };
        if available_out > 0 { output = string.{ ptr = @out.ptr[output_at], len = available_out }; }
        progress := state.step(input, output, input_limit == plain.len) catch (e) {
            if raw != null { alloc.dealloc_bytes(raw); }
            return false;
        };
        input_at += progress.consumed;
        output_at += progress.produced;
        if progress.status == .done {
            ended := true;
            state.end() catch (e) { ended = false; };
            ok := ended and input_at == plain.len and output_at == expected.len and mz.bytes_equal(out, expected);
            state.deinit(); state.deinit();
            if raw != null { alloc.dealloc_bytes(raw); }
            return ok;
        }
        if progress.status == .need_input {
            if input_at != input_limit or input_limit >= plain.len { if raw != null { alloc.dealloc_bytes(raw); } return false; }
            input_limit += input_chunk;
            if input_limit > plain.len { input_limit = plain.len; }
        }
        if progress.status == .need_output and output_at >= expected.len { if raw != null { alloc.dealloc_bytes(raw); } return false; }
        turns += 1;
    }
    if raw != null { alloc.dealloc_bytes(raw); }
    false
}

drive_gzip :: (packed: string, plain: string, alloc: Allocator) -> bool {
    state := mz.GzipInflater.init(plain.len, alloc);
    defer state.deinit();
    raw := alloc.alloc_bytes(plain.len);
    out := string.{ ptr = xx raw, len = plain.len };
    input_at := 0;
    output_at := 0;
    turns := 0;
    while turns < packed.len * 8 + plain.len * 4 + 100 {
        input : string = .{ ptr = null, len = 0 };
        if input_at < packed.len { input = string.{ ptr = @packed.ptr[input_at], len = 1 }; }
        output : string = .{ ptr = null, len = 0 };
        if output_at < plain.len { output = string.{ ptr = @out.ptr[output_at], len = 1 }; }
        progress := state.step(input, output, input_at + input.len == packed.len) catch (e) {
            if raw != null { alloc.dealloc_bytes(raw); }
            return false;
        };
        input_at += progress.consumed;
        output_at += progress.produced;
        if progress.status == .done {
            ended := true;
            state.end() catch (e) { ended = false; };
            ok := ended and input_at == packed.len and output_at == plain.len and mz.bytes_equal(out, plain);
            state.deinit();
            if raw != null { alloc.dealloc_bytes(raw); }
            return ok;
        }
        if progress.status == .need_input and input_at >= packed.len { if raw != null { alloc.dealloc_bytes(raw); } return false; }
        if progress.status == .need_output and output_at >= plain.len { if raw != null { alloc.dealloc_bytes(raw); } return false; }
        turns += 1;
    }
    if raw != null { alloc.dealloc_bytes(raw); }
    false
}

drive_deflater :: (plain: string, expected: string, exact: bool, level: i64, input_chunk: i64, output_chunk: i64, alloc: Allocator) -> bool {
    state := mz.Deflater.init(level, alloc);
    capacity := plain.len * 2 + 1024;
    raw := alloc.alloc_bytes(capacity);
    out := string.{ ptr = xx raw, len = capacity };
    input_at := 0;
    input_limit := input_chunk;
    if input_limit > plain.len { input_limit = plain.len; }
    output_at := 0;
    turns := 0;
    while turns < plain.len * 8 + capacity * 8 + 100 {
        input : string = .{ ptr = null, len = 0 };
        if input_at < input_limit { input = string.{ ptr = @plain.ptr[input_at], len = input_limit - input_at }; }
        available_out := capacity - output_at;
        if available_out > output_chunk { available_out = output_chunk; }
        output : string = .{ ptr = null, len = 0 };
        if available_out > 0 { output = string.{ ptr = @out.ptr[output_at], len = available_out }; }
        progress := state.step(input, output, input_limit == plain.len) catch (e) { state.deinit(); alloc.dealloc_bytes(raw); return false; };
        input_at += progress.consumed;
        output_at += progress.produced;
        if progress.status == .done {
            packed := string.{ ptr = out.ptr, len = output_at };
            decoded := mz.inflate(packed, plain.len, alloc) catch (e) { state.deinit(); alloc.dealloc_bytes(raw); return false; };
            ok := input_at == plain.len and mz.bytes_equal(decoded, plain);
            if exact { ok = ok and mz.bytes_equal(packed, expected); }
            alloc.dealloc_bytes(decoded.ptr);
            state.deinit();
            alloc.dealloc_bytes(raw);
            return ok;
        }
        if progress.status == .need_input {
            if input_at != input_limit or input_limit >= plain.len { state.deinit(); alloc.dealloc_bytes(raw); return false; }
            input_limit += input_chunk;
            if input_limit > plain.len { input_limit = plain.len; }
        }
        if progress.status == .need_output and output_at >= capacity { state.deinit(); alloc.dealloc_bytes(raw); return false; }
        turns += 1;
    }
    state.deinit();
    alloc.dealloc_bytes(raw);
    false
}

drive_zlib_deflater :: (plain: string, expected: string, alloc: Allocator) -> bool {
    state := mz.ZlibDeflater.init(9, alloc);
    raw := alloc.alloc_bytes(plain.len * 2 + 1024);
    storage := string.{ ptr = xx raw, len = plain.len * 2 + 1024 };
    input_at := 0; output_at := 0; input_limit := 0; turns := 0;
    while turns < plain.len * 8 + storage.len * 8 + 100 {
        if input_limit < plain.len { input_limit += 1; }
        input : string = .{ ptr = null, len = 0 };
        if input_at < input_limit { input = string.{ ptr = @plain.ptr[input_at], len = input_limit - input_at }; }
        output : string = .{ ptr = null, len = 0 };
        if output_at < storage.len { output = string.{ ptr = @storage.ptr[output_at], len = 1 }; }
        progress := state.step(input, output, input_limit == plain.len) catch (e) { state.deinit(); alloc.dealloc_bytes(raw); return false; };
        input_at += progress.consumed; output_at += progress.produced;
        if progress.status == .done {
            packed := string.{ ptr = storage.ptr, len = output_at };
            decoded := mz.decompress(packed, plain.len, alloc) catch (e) { state.deinit(); alloc.dealloc_bytes(raw); return false; };
            ok := mz.bytes_equal(decoded, plain) and mz.bytes_equal(packed, expected);
            alloc.dealloc_bytes(decoded.ptr); state.deinit(); alloc.dealloc_bytes(raw); return ok;
        }
        turns += 1;
    }
    state.deinit(); alloc.dealloc_bytes(raw); false
}

drive_gzip_deflater :: (plain: string, expected: string, alloc: Allocator) -> bool {
    state := mz.GzipDeflater.init(9, alloc);
    raw := alloc.alloc_bytes(plain.len * 2 + 1024);
    storage := string.{ ptr = xx raw, len = plain.len * 2 + 1024 };
    input_at := 0; output_at := 0; input_limit := 0; turns := 0;
    while turns < plain.len * 8 + storage.len * 8 + 100 {
        if input_limit < plain.len { input_limit += 1; }
        input : string = .{ ptr = null, len = 0 };
        if input_at < input_limit { input = string.{ ptr = @plain.ptr[input_at], len = input_limit - input_at }; }
        output : string = .{ ptr = null, len = 0 };
        if output_at < storage.len { output = string.{ ptr = @storage.ptr[output_at], len = 1 }; }
        progress := state.step(input, output, input_limit == plain.len) catch (e) { state.deinit(); alloc.dealloc_bytes(raw); return false; };
        input_at += progress.consumed; output_at += progress.produced;
        if progress.status == .done {
            packed := string.{ ptr = storage.ptr, len = output_at };
            decoded := mz.gzip_decompress(packed, plain.len, alloc) catch (e) { state.deinit(); alloc.dealloc_bytes(raw); return false; };
            ok := mz.bytes_equal(decoded, plain) and mz.bytes_equal(packed, expected);
            alloc.dealloc_bytes(decoded.ptr); state.deinit(); alloc.dealloc_bytes(raw); return ok;
        }
        turns += 1;
    }
    state.deinit(); alloc.dealloc_bytes(raw); false
}

main :: () -> i32 {
    gpa := mem.GPA.init();

    fixed_plain := "streaming fixed huffman: abcabcabcabcabcabcabcabcabcabc";
    fixed := mz.deflate(fixed_plain, 3, gpa);
    split := 0;
    while split <= fixed.len {
        if !drive_split(fixed, fixed_plain, split, gpa) { print("fixed split {} failed\n", split); return 1; }
        split += 1;
    }
    if !drive_deflater(fixed_plain, fixed, true, 3, 1, 1, gpa) { return 1; }

    skew_raw := gpa.alloc_bytes(3000);
    skew := string.{ ptr = xx skew_raw, len = 3000 };
    state := 0x31415926;
    i := 0;
    while i < skew.len {
        state = (state ^ (state << 13)) & 0xffffffff;
        state = state ^ (state >> 17);
        state = (state ^ (state << 5)) & 0xffffffff;
        skew.ptr[i] = ('A' + state % 10).(u8);
        i += 1;
    }
    dynamic := mz.deflate(skew, 9, gpa);
    if ((dynamic[0] >> 1) & 3) != 2 or !drive_chunks(dynamic, skew, 1, 1, gpa) { return 1; }
    if !drive_deflater(skew, dynamic, true, 9, 37, 19, gpa) { return 1; }
    framed := mz.compress(skew, 9, gpa);
    if !drive_zlib(framed, skew, gpa) { return 1; }
    if !drive_zlib_deflater(skew, framed, gpa) { return 1; }

    gzip_options := mz.GzipOptions.{ filename = "one.txt", comment = "stream member", extra = "extra", header_crc = true };
    gzip_first := mz.gzip_compress_options("member one", gzip_options, 6, gpa) catch (e) { return 1; };
    gzip_second := mz.gzip_compress(" + member two", 9, gpa);
    gzip_stream_expected := mz.gzip_compress(skew, 9, gpa);
    if !drive_gzip_deflater(skew, gzip_stream_expected, gpa) { return 1; }
    gzip_joined_writer := mz.ByteWriter.init(gpa);
    gzip_joined_writer.put_bytes(gzip_first);
    gzip_joined_writer.put_bytes(gzip_second);
    gzip_joined := gzip_joined_writer.take();
    if !drive_gzip(gzip_joined, "member one + member two", gpa) { return 1; }

    stored_raw := gpa.alloc_bytes(65536);
    stored_plain := string.{ ptr = xx stored_raw, len = 65536 };
    i = 0;
    while i < stored_plain.len { stored_plain.ptr[i] = (i & 0xff).(u8); i += 1; }
    stored := mz.deflate_stored(stored_plain, gpa);
    tdefl_stored := mz.deflate(stored_plain, 0, gpa);
    if !drive_chunks(stored, stored_plain, 257, 113, gpa) { return 1; }
    if !drive_stored_deflater(stored_plain, stored, 257, 113, gpa) { return 1; }
    if !drive_deflater(stored_plain, tdefl_stored, true, 0, 257, 113, gpa) { return 1; }
    if !drive_deflater(stored_plain, "", false, 9, 257, 113, gpa) { return 1; }

    empty := mz.deflate_stored("", gpa);
    if !drive_chunks(empty, "", 1, 1, gpa) { return 1; }
    if !drive_stored_deflater("", empty, 1, 1, gpa) { return 1; }

    // Explicit end-of-input distinguishes truncation from ordinary need-input.
    truncated := mz.Inflater.init(1000, gpa);
    sink : [8]u8 = ---;
    partial := string.{ ptr = fixed.ptr, len = fixed.len - 1 };
    progress := truncated.step(partial, string.{ ptr = @sink[0], len = sink.len }) catch (e) { return 1; };
    if progress.status == .done { return 1; }
    ended_bad := false;
    truncated.end() catch (e) { if e == error.UnexpectedEnd { ended_bad = true; } };
    truncated.deinit();
    if !ended_bad { return 1; }

    limited := mz.Inflater.init(fixed_plain.len - 1, gpa);
    limit_out : [128]u8 = ---;
    limit_failed := false;
    limited_progress := limited.step(fixed, string.{ ptr = @limit_out[0], len = limit_out.len }) catch (e) {
        if e == error.OutputLimit { limit_failed = true; }
        mz.StreamProgress.{ consumed = 0, produced = 0, status = .need_input }
    };
    limited.deinit();
    if !limit_failed { return 1; }

    reusable := mz.Inflater.init(fixed_plain.len, gpa);
    reuse_out : [128]u8 = ---;
    first_pass := reusable.step(fixed, string.{ ptr = @reuse_out[0], len = reuse_out.len }) catch (e) { return 1; };
    if first_pass.status != .done or first_pass.produced != fixed_plain.len { return 1; }
    reusable.reset(fixed_plain.len);
    second_pass := reusable.step(fixed, string.{ ptr = @reuse_out[0], len = reuse_out.len }) catch (e) { return 1; };
    if second_pass.status != .done or second_pass.produced != fixed_plain.len { return 1; }
    reusable.deinit();
    reusable.deinit();

    // Encoder reset releases a pending compressed block, and unfinished end
    // remains a typed truncation rather than silently finalizing.
    reset_encoder := mz.Deflater.init(9, gpa);
    pending_progress := reset_encoder.step(fixed_plain, "", true) catch (e) { return 1; };
    if pending_progress.status != .need_output { return 1; }
    reset_encoder.reset(6);
    unfinished_progress := reset_encoder.step("abc", "", false) catch (e) { return 1; };
    if unfinished_progress.status != .need_input { return 1; }
    encoder_end_failed := false;
    reset_encoder.end() catch (e) { if e == error.UnexpectedEnd { encoder_end_failed = true; } };
    reset_encoder.deinit(); reset_encoder.deinit();
    if !encoder_end_failed { return 1; }

    gpa.dealloc_bytes(empty.ptr);
    gpa.dealloc_bytes(tdefl_stored.ptr);
    gpa.dealloc_bytes(stored.ptr);
    gpa.dealloc_bytes(stored_raw);
    gpa.dealloc_bytes(dynamic.ptr);
    gpa.dealloc_bytes(framed.ptr);
    gpa.dealloc_bytes(gzip_joined.ptr);
    gpa.dealloc_bytes(gzip_second.ptr);
    gpa.dealloc_bytes(gzip_first.ptr);
    gpa.dealloc_bytes(gzip_stream_expected.ptr);
    gpa.dealloc_bytes(skew_raw);
    gpa.dealloc_bytes(fixed.ptr);
    if gpa.alloc_count != 0 { print("stream leaked allocations: {}\n", gpa.alloc_count); return 1; }
    print("streaming codec ok\n");
    0
}
