#import "modules/std/core.sx";
mz :: #import "../miniz.sx";

main :: () -> i32 {
    // A namespaced source import is SX's header-only/include-once equivalent;
    // declarations are module exports without a C visibility macro.
    if mz.version() == "11.3.2" and mz.crc32("123456789") == 0xcbf43926 then 0 else 1
}
