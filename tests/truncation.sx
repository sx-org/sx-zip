#import "modules/std.sx";
mz :: #import "../miniz.sx";

raw_truncations_fail :: (packed: string, alloc: Allocator) -> bool {
    n := 0;
    while n < packed.len {
        view : string = .{ ptr = null, len = 0 };
        if n > 0 { view = string.{ ptr = packed.ptr, len = n }; }
        failed := false;
        out := mz.inflate(view, 10000, alloc) catch (e) { failed = true; string.{ ptr = null, len = 0 } };
        if out.ptr != null { alloc.dealloc_bytes(out.ptr); }
        if !failed { return false; }
        n += 1;
    }
    true
}

zlib_truncations_fail :: (packed: string, alloc: Allocator) -> bool {
    n := 0;
    while n < packed.len {
        view : string = .{ ptr = null, len = 0 };
        if n > 0 { view = string.{ ptr = packed.ptr, len = n }; }
        failed := false;
        out := mz.decompress(view, 10000, alloc) catch (e) { failed = true; string.{ ptr = null, len = 0 } };
        if out.ptr != null { alloc.dealloc_bytes(out.ptr); }
        if !failed { return false; }
        n += 1;
    }
    true
}

gzip_truncations_fail :: (packed: string, alloc: Allocator) -> bool {
    n := 0;
    while n < packed.len {
        view : string = .{ ptr = null, len = 0 };
        if n > 0 { view = string.{ ptr = packed.ptr, len = n }; }
        failed := false;
        out := mz.gzip_decompress(view, 10000, alloc) catch (e) { failed = true; string.{ ptr = null, len = 0 } };
        if out.ptr != null { alloc.dealloc_bytes(out.ptr); }
        if !failed { return false; }
        n += 1;
    }
    true
}

main :: () -> i32 {
    gpa := mem.GPA.init();
    plain := "truncate every byte and mutate every framed bit: abcabcabcabcabcabc";
    raw := mz.deflate(plain, 9, gpa);
    framed := mz.compress(plain, 9, gpa);
    gzip := mz.gzip_compress(plain, 9, gpa);
    if !raw_truncations_fail(raw, gpa) or !zlib_truncations_fail(framed, gpa) or !gzip_truncations_fail(gzip, gpa) { return 1; }

    files : [1]mz.ZipInput = .[mz.ZipInput.{ name = "payload.txt", data = plain, method = .deflate, level = 9 }];
    archive := mz.create_zip(files, gpa) catch (e) { return 1; };
    n := 0;
    while n < archive.len {
        view : string = .{ ptr = null, len = 0 };
        if n > 0 { view = string.{ ptr = archive.ptr, len = n }; }
        failed := false;
        reader := mz.open_zip(view) catch (e) {
            failed = true;
            mz.ZipReader.{ data = "", central_offset = 0, central_size = 0, count = 0, comment = "" }
        };
        if !failed { return 1; }
        n += 1;
    }

    // Framing checksum makes payload/header mutations fail closed. Mutations
    // of legal DEFLATE padding may still decode, but only to identical bytes.
    mutated_raw := gpa.alloc_bytes(framed.len);
    mutated := string.{ ptr = xx mutated_raw, len = framed.len };
    bit := 0;
    while bit < framed.len * 8 {
        i := 0;
        while i < framed.len { mutated.ptr[i] = framed[i]; i += 1; }
        mutated.ptr[bit / 8] = mutated.ptr[bit / 8] ^ (1 << (bit & 7)).(u8);
        out := mz.decompress(mutated, 10000, gpa) catch (e) { string.{ ptr = null, len = 0 } };
        if out.ptr != null {
            if !mz.bytes_equal(out, plain) { gpa.dealloc_bytes(out.ptr); return 1; }
            gpa.dealloc_bytes(out.ptr);
        }
        bit += 1;
    }

    gpa.dealloc_bytes(mutated_raw);
    gpa.dealloc_bytes(archive.ptr);
    gpa.dealloc_bytes(gzip.ptr);
    gpa.dealloc_bytes(framed.ptr);
    gpa.dealloc_bytes(raw.ptr);
    if gpa.alloc_count != 0 { print("truncation leaked allocations: {}\n", gpa.alloc_count); return 1; }
    print("truncation corpus ok\n");
    0
}
