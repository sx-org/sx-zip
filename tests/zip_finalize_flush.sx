#import "modules/std.sx";
mz :: #import "../miniz.sx";

State :: struct { out: mz.ByteWriter; }
write :: (ctx: *void, data: string) -> bool {
    state : *State = xx ctx; state.out.put_bytes(data); true
}
fail_flush :: (ctx: *void) -> bool { false }
record :: (out: *mz.ByteWriter, ok: bool, writer: *mz.ZipStreamWriter) {
    out.put_u32le(if ok then 1 else 0); out.put_u32le(mz.zip_error_code(writer.take_last_error()));
    out.put_u32le(writer.size());
    mode := writer.mode(); out.put_u32le(if mode == .invalid then 0 else if mode == .reading then 1 else if mode == .writing then 2 else 3);
}

main :: () -> i32 {
    gpa := mem.GPA.init(); transcript := mz.ByteWriter.init(gpa);
    state := State.{ out = mz.ByteWriter.init(gpa) };
    writer := mz.ZipStreamWriter.init(mz.ZipSink.{ ctx = xx @state, write = write, flush = fail_flush }, gpa);
    writer.storage = .cfile;
    record(@transcript, true, @writer);
    add_ok := true; writer.add_options("entry", "payload", mz.ZipEntryOptions.{ method = .store, level = 0, time_mode = .none }) catch (e) { add_ok = false; };
    record(@transcript, add_ok, @writer);
    finish_ok := true; writer.finish() catch (e) { finish_ok = false; };
    record(@transcript, finish_ok, @writer);
    record(@transcript, writer.end(), @writer);
    state.out.deinit(); bytes := transcript.take(); wrote := fs.write_file("/tmp/sx-zip-finalize-flush.bin", bytes); gpa.dealloc_bytes(bytes.ptr);
    if wrote and gpa.alloc_count == 0 then 0 else 1
}
