#import "modules/std.sx";
mz :: #import "../miniz.sx";

// Deterministic seed-corpus equivalents of the applicable upstream miniz
// checksum_fuzzer, compress_fuzzer, uncompress_fuzzer, and zip_fuzzer
// strategies. The staging port deliberately does not depend on libFuzzer.

SIZES : [15]i64 : .[1, 2, 3, 4, 7, 15, 31, 255, 256, 257, 1023, 1024, 2047, 4095, 4096];

roundtrip_level :: (data: string, level: i64, alloc: Allocator) -> bool {
    packed := mz.compress(data, level, alloc);
    plain := mz.decompress(packed, data.len, alloc) catch (e) {
        alloc.dealloc_bytes(packed.ptr);
        return false;
    };
    ok := mz.bytes_equal(data, plain);
    if plain.ptr != null { alloc.dealloc_bytes(plain.ptr); }
    alloc.dealloc_bytes(packed.ptr);
    ok
}

exercise_arbitrary_zlib :: (data: string, max_output: i64, alloc: Allocator) {
    plain := mz.decompress(data, max_output, alloc) catch (e) {
        string.{ ptr = null, len = 0 }
    };
    if plain.ptr != null { alloc.dealloc_bytes(plain.ptr); }
}

validate_archive_if_open :: (data: string, alloc: Allocator) -> bool {
    opened := true;
    reader := mz.open_zip(data) catch (e) {
        opened = false;
        mz.ZipReader.{ data = "", central_offset = 0, central_size = 0, count = 0, comment = "" }
    };
    if !opened { return true; }
    i := 0;
    while i < reader.count {
        valid_entry := true;
        entry := reader.entry(i) catch (e) {
            valid_entry = false;
            mz.ZipEntry.{}
        };
        if valid_entry and !entry.is_dir() and entry.size <= 262144 {
            plain := reader.extract(i, 262144, alloc) catch (e) {
                string.{ ptr = null, len = 0 }
            };
            if plain.ptr != null { alloc.dealloc_bytes(plain.ptr); }
        }
        i += 1;
    }
    true
}

main :: () -> i32 {
    gpa := mem.GPA.init();
    raw := gpa.alloc_bytes(4096);
    seed := string.{ ptr = xx raw, len = 4096 };

    state := 0x9e3779b9;
    i := 0;
    while i < seed.len {
        state = (state ^ (state << 13)) & 0xffffffff;
        state = state ^ (state >> 17);
        state = (state ^ (state << 5)) & 0xffffffff;
        seed.ptr[i] = (state & 0xff).(u8);
        i += 1;
    }

    // Upstream checksum/compress harness policy: non-empty inputs up to the
    // cap, with zlib round-trips at levels 1, 3, 6, and 7.
    si := 0;
    while si < SIZES.len {
        view := string.{ ptr = seed.ptr, len = SIZES[si] };
        whole_crc := mz.crc32(view);
        whole_adler := mz.adler32(view);
        split := view.len / 2;
        first := string.{ ptr = view.ptr, len = split };
        second := string.{ ptr = @view.ptr[split], len = view.len - split };
        if mz.crc32(second, mz.crc32(first)) != whole_crc or mz.adler32(second, mz.adler32(first)) != whole_adler {
            gpa.dealloc_bytes(raw);
            return 1;
        }
        if !roundtrip_level(view, 1, gpa) or !roundtrip_level(view, 3, gpa) or !roundtrip_level(view, 6, gpa) or !roundtrip_level(view, 7, gpa) {
            gpa.dealloc_bytes(raw);
            return 1;
        }
        si += 1;
    }

    // Upstream uncompress fuzzers derive a bounded output capacity from the
    // first bytes and accept either typed rejection or a bounded result.
    n := 1;
    while n <= 128 {
        length := 1 + ((seed[n - 1].(i64) * 17 + n * 29) % 4096);
        limit := seed[(n * 7) & 4095].(i64) * seed[(n * 13) & 4095].(i64);
        exercise_arbitrary_zlib(string.{ ptr = seed.ptr, len = length }, limit, gpa);
        n += 1;
    }

    files : [2]mz.ZipInput = .[
        mz.ZipInput.{ name = "seed.bin", data = string.{ ptr = seed.ptr, len = 4096 }, method = .deflate, level = 7 },
        mz.ZipInput.{ name = "empty", data = "", method = .store, level = 0 },
    ];
    archive := mz.create_zip(files, gpa) catch (e) { gpa.dealloc_bytes(raw); return 1; };
    if !validate_archive_if_open(archive, gpa) { return 1; }

    // Bytewise mutations model the upstream ZIP validation fuzzer. A mutation
    // may be harmless, rejected, or still parse; any parsed entry is exercised
    // through bounded extraction and all owned results are released.
    mutated_raw := gpa.alloc_bytes(archive.len);
    mutated := string.{ ptr = xx mutated_raw, len = archive.len };
    at := 0;
    while at < archive.len {
        i = 0;
        while i < archive.len { mutated.ptr[i] = archive[i]; i += 1; }
        mutated.ptr[at] = mutated.ptr[at] ^ (1 << (at & 7)).(u8);
        if !validate_archive_if_open(mutated, gpa) { return 1; }
        at += 1;
    }

    gpa.dealloc_bytes(mutated_raw);
    gpa.dealloc_bytes(archive.ptr);
    gpa.dealloc_bytes(raw);
    if gpa.alloc_count != 0 { print("upstream fuzz corpus leaked allocations: {}\n", gpa.alloc_count); return 1; }
    print("upstream fuzz strategies ok\n");
    0
}
