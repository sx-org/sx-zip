#import "modules/std.sx";
mz :: #import "../miniz.sx";

put_bytes :: (out: *mz.ByteWriter, data: string) {
    out.put_u32le(data.len); out.put_bytes(data);
}

record :: (out: *mz.ByteWriter, ok: bool, reader: *mz.ZipReader) {
    out.put_u32le(if ok then 1 else 0);
    out.put_u32le(mz.zip_error_code(reader.take_last_error()));
}

enumerate :: (out: *mz.ByteWriter, reader: *mz.ZipReader) -> bool {
    i := 0;
    while i < reader.num_files() {
        reader.clear_last_error(); record(out, reader.is_file_directory(i), reader);
        reader.clear_last_error(); record(out, reader.is_file_encrypted(i), reader);
        reader.clear_last_error(); record(out, reader.is_file_supported(i), reader);
        reader.clear_last_error(); out.put_u32le(reader.get_filename_into(i, ""));
        out.put_u32le(mz.zip_error_code(reader.take_last_error()));
        small : [4]u8 = .[0xcc, 0xcc, 0xcc, 0xcc];
        reader.clear_last_error(); n := reader.get_filename_into(i, string.{ ptr = @small[0], len = small.len });
        out.put_u32le(n); out.put_u32le(mz.zip_error_code(reader.take_last_error()));
        put_bytes(out, string.{ ptr = @small[0], len = small.len });
        full : [520]u8 = ---; j := 0; while j < full.len { full[j] = 0xcc; j += 1; }
        reader.clear_last_error(); n = reader.get_filename_into(i, string.{ ptr = @full[0], len = full.len });
        out.put_u32le(n); out.put_u32le(mz.zip_error_code(reader.take_last_error()));
        put_bytes(out, string.{ ptr = @full[0], len = n });
        reader.clear_last_error(); ok := true; entry := reader.entry(i) catch (e) { ok = false; mz.ZipEntry.{} };
        record(out, ok, reader);
        if !ok { i += 1; continue; }
        out.put_u32le(i); out.put_u32le(entry.central_offset - reader.central_offset);
        out.put_u32le(entry.version_made_by); out.put_u32le(entry.version_needed);
        out.put_u32le(entry.flags); out.put_u32le(entry.method_value);
        out.put_u32le(entry.crc); out.put_u32le(entry.compressed_size); out.put_u32le(entry.size);
        out.put_u32le(entry.internal_attributes); out.put_u32le(entry.external_attributes); out.put_u32le(entry.local_offset);
        out.put_u32le(entry.comment.len); out.put_u32le(if entry.is_dir() then 1 else 0);
        out.put_u32le(if entry.is_encrypted() then 1 else 0); out.put_u32le(if entry.is_supported() then 1 else 0);
        put_bytes(out, entry.name); put_bytes(out, entry.comment);
        i += 1;
    }
    true
}

locate :: (out: *mz.ByteWriter, reader: *mz.ZipReader, name: string, comment: string, supplied: bool, options: mz.ZipLocateOptions) {
    reader.clear_last_error(); index : i64 = 0xdeadbeef; actual := options;
    actual.comment_supplied = supplied;
    ok := reader.locate_v2(name, comment, actual, @index);
    out.put_u32le(if ok then 1 else 0); out.put_u32le(index);
    out.put_u32le(mz.zip_error_code(reader.take_last_error()));
}

queries :: (out: *mz.ByteWriter, reader: *mz.ZipReader) {
    locate(out, reader, "ALPHA.TXT", "", false, .{});
    locate(out, reader, "Alpha.TXT", "", false, .{ case_sensitive = true });
    locate(out, reader, "alpha.txt", "", false, .{ case_sensitive = true });
    locate(out, reader, "Leaf.bin", "", false, .{ ignore_path = true });
    locate(out, reader, "Back.dat", "", false, .{ ignore_path = true });
    locate(out, reader, "Colon", "", false, .{ ignore_path = true });
    locate(out, reader, "dup", "", false, .{});
    locate(out, reader, "dup", "", true, .{});
    locate(out, reader, "dup", "note", true, .{});
    locate(out, reader, "DUP", "NOTE", true, .{});
    locate(out, reader, "dup", "missing", true, .{});
    locate(out, reader, "missing", "", false, .{});
}

main :: () -> i32 {
    gpa := mem.GPA.init(); out := mz.ByteWriter.init(gpa);
    maybe := fs.read_file("/tmp/miniz-zip-lookup-matrix.zip");
    if maybe == null { return 1; }
    archive := maybe!;
    reader := mz.open_zip(archive) catch (e) { context.allocator.dealloc_bytes(archive.ptr); return 2; };
    if !enumerate(@out, @reader) { return 3; }
    queries(@out, @reader); reader.end();
    reader = mz.open_zip(archive) catch (e) { context.allocator.dealloc_bytes(archive.ptr); return 4; };
    reader.set_sorted_lookup(false); queries(@out, @reader); reader.end();
    context.allocator.dealloc_bytes(archive.ptr);
    bytes := out.take(); wrote := fs.write_file("/tmp/sx-zip-lookup-matrix.bin", bytes); gpa.dealloc_bytes(bytes.ptr);
    if !wrote or gpa.alloc_count != 0 {
        print("lookup matrix output failed wrote={} allocations={}\n", wrote, gpa.alloc_count);
        return 5;
    }
    0
}
