#import "modules/std.sx";
#import "modules/build.sx";
mz :: #import "../miniz.sx";

// Android IR requires a launchable Activity declaration. The empty class is
// only an entry-point witness; main reaches the complete miniz filesystem
// adapter surface so target-specific declarations cannot be removed by DCE.
SxMinizSurface :: #jni_main #jni_class("co/swipelab/sxminiz/SxMinizSurface") { }

main :: () -> i32 {
    last_error : mz.ZipError = .no_error;

    writer := mz.open_zip_writer_file_with_error("sx-miniz-android.zip", @last_error, 0, false, true) catch (e) { return 1; };
    writer.writer.add_file_default("source", "sx-miniz-android-source.bin") catch (e) {
        writer.end();
        return 2;
    };
    writer.finish() catch (e) { writer.end(); return 3; };
    if !writer.end() { return 4; }

    reader := mz.open_zip_file_with_error("sx-miniz-android.zip", @last_error) catch (e) { return 5; };
    mz.zip_extract_to_file(@reader.reader, 0, "sx-miniz-android-output.bin") catch (e) {
        reader.end();
        return 6;
    };
    if !reader.end() { return 7; }

    if !mz.validate_zip_file_with_error("sx-miniz-android.zip", @last_error) { return 8; }
    if !mz.zip_add_to_file_in_place_with_error("sx-miniz-android-update.zip", "entry", "payload", @last_error) { return 9; }
    0
}
