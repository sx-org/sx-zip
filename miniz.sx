// miniz.sx -- dependency-free native sx port of miniz 3.1.2.
//
// This is a native sx port of miniz's format core. It deliberately exposes an
// sx-shaped, allocator-aware API instead of reproducing the C ABI. All returned
// strings own their backing storage through the allocator supplied to the call.
//
// The pinned upstream library is the scope. docs/COVERAGE.md records every
// public entry point and internal/configuration path; no upstream-supported
// behavior is intentionally excluded. Unsupported upstream formats still fail
// explicitly instead of being interpreted as another format.

#import "modules/std/core.sx";
#import "modules/std/list.sx";
inline if OS == .windows {
    fs :: #import "modules/miniz/windows_fs.sx";
} else {
    fs :: #import "modules/std/fs.sx";
}

Error :: error {
    InvalidData,
    UnexpectedEnd,
    ChecksumMismatch,
    Unsupported,
    OutputLimit,
    NotFound,
    TooLarge,
    Finished,
    Io,
    AllocationFailed,
    FailedFindingCentralDir,
}

VERSION :: "11.3.2";

version :: () -> string { VERSION }

MZ_OK : i64 = 0;
MZ_STREAM_END : i64 = 1;
MZ_NEED_DICT : i64 = 2;
MZ_ERRNO : i64 = -1;
MZ_STREAM_ERROR : i64 = -2;
MZ_DATA_ERROR : i64 = -3;
MZ_MEM_ERROR : i64 = -4;
MZ_BUF_ERROR : i64 = -5;
MZ_VERSION_ERROR : i64 = -6;
MZ_PARAM_ERROR : i64 = -10000;

MzFlush :: enum { none; partial; sync; full; finish; }

MzProgress :: struct {
    consumed: i64;
    produced: i64;
    status: i64;
}

// Native equivalent of mz_error(). `known=false` is the C NULL case.
error_string :: (status: i64) -> (string, bool) {
    if status == MZ_OK { return "", true; }
    if status == MZ_STREAM_END { return "stream end", true; }
    if status == MZ_NEED_DICT { return "need dictionary", true; }
    if status == MZ_ERRNO { return "file error", true; }
    if status == MZ_STREAM_ERROR { return "stream error", true; }
    if status == MZ_DATA_ERROR { return "data error", true; }
    if status == MZ_MEM_ERROR { return "out of memory", true; }
    if status == MZ_BUF_ERROR { return "buf error", true; }
    if status == MZ_VERSION_ERROR { return "version error", true; }
    if status == MZ_PARAM_ERROR { return "parameter error", true; }
    return "", false;
}

// `mz_free` delegates to the active allocator in native sx.
free_owned :: (data: string, alloc: Allocator = context.allocator) {
    if data.ptr != null { alloc.dealloc_bytes(data.ptr); }
}

CompressionStrategy :: enum { default; filtered; huffman_only; rle; fixed; }
DeflatePath :: enum { fastest; portable; }

FlushMode :: enum { none; sync; full; finish; }

TDEFL_WRITE_ZLIB_HEADER : i64 = 0x01000;
TDEFL_COMPUTE_ADLER32 : i64 = 0x02000;
TDEFL_GREEDY_PARSING : i64 = 0x04000;
TDEFL_NONDETERMINISTIC_PARSING : i64 = 0x08000;
TDEFL_RLE_MATCHES : i64 = 0x10000;
TDEFL_FILTER_MATCHES : i64 = 0x20000;
TDEFL_FORCE_ALL_STATIC_BLOCKS : i64 = 0x40000;
TDEFL_FORCE_ALL_RAW_BLOCKS : i64 = 0x80000;
TDEFL_MAX_PROBES_MASK : i64 = 0x0fff;

TDEFL_PROBES : [11]i64 = .[0, 1, 6, 32, 16, 32, 128, 256, 512, 768, 1500];
TDEFL_RAW_BLOCK_LIMIT : i64 = 31745;
TDEFL_LESS_MEMORY_RAW_BLOCK_LIMIT : i64 = 21839;

TINFL_FLAG_PARSE_ZLIB_HEADER : i64 = 1;
TINFL_FLAG_HAS_MORE_INPUT : i64 = 2;
TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF : i64 = 4;
TINFL_FLAG_COMPUTE_ADLER32 : i64 = 8;

// Exact native equivalent of tdefl_create_comp_flags_from_zip_params().
// The zlib-compatible default level is 6; miniz's level 10 is its deliberately
// slow “uber” mode and is kept distinct from level 9.
compression_flags :: (level: i64, window_bits: i64 = 15, strategy: CompressionStrategy = .default) -> i64 {
    actual := if level < 0 then 6 else if level > 10 then 10 else level;
    flags := TDEFL_PROBES[actual];
    if level <= 3 { flags = flags | TDEFL_GREEDY_PARSING; }
    if window_bits > 0 { flags = flags | TDEFL_WRITE_ZLIB_HEADER; }
    if level == 0 { flags = flags | TDEFL_FORCE_ALL_RAW_BLOCKS; }
    else if strategy == .filtered { flags = flags | TDEFL_FILTER_MATCHES; }
    else if strategy == .huffman_only { flags = flags & ~TDEFL_MAX_PROBES_MASK; }
    else if strategy == .fixed { flags = flags | TDEFL_FORCE_ALL_STATIC_BLOCKS; }
    else if strategy == .rle { flags = flags | TDEFL_RLE_MATCHES; }
    flags
}

// miniz's public bound is intentionally conservative.
compress_bound :: (source_len: i64) -> (i64, !Error) {
    if source_len < 0 or source_len > 83848836698679778 { raise error.TooLarge; }
    ratio_bound := 128 + (source_len * 110) / 100;
    block_bound := 128 + source_len + ((source_len / (31 * 1024)) + 1) * 5;
    if ratio_bound > block_bound then ratio_bound else block_bound
}

// -----------------------------------------------------------------------------
// Checksums

adler32 :: (data: string, initial: i64 = 1) -> i64 {
    // mz_adler32() treats a null source pointer as an initializer query,
    // independently of the supplied accumulator. Preserve that observable
    // behavior for sx's canonical null empty slice.
    if data.ptr == null { return 1; }
    // miniz keeps both accumulators in mz_uint32. A 5,552-byte block is
    // specifically small enough to avoid overflow, so widening these to i64
    // only makes the hot dependency chain and modulo operations more costly.
    s1 := (initial & 0xffff).(u32);
    s2 := ((initial >> 16) & 0xffff).(u32);
    remaining := data.len;
    block_len := remaining % 5552;
    at := 0;
    while remaining > 0 {
        end := at + block_len;
        // This is miniz's eight-byte dependency-unrolled checksum loop.
        // Besides matching the upstream fast path, the straight-line updates
        // avoid a branch and index recurrence for every source byte.
        while at + 7 < end {
            s1 += data[at].(u32); s2 += s1;
            s1 += data[at + 1].(u32); s2 += s1;
            s1 += data[at + 2].(u32); s2 += s1;
            s1 += data[at + 3].(u32); s2 += s1;
            s1 += data[at + 4].(u32); s2 += s1;
            s1 += data[at + 5].(u32); s2 += s1;
            s1 += data[at + 6].(u32); s2 += s1;
            s1 += data[at + 7].(u32); s2 += s1;
            at += 8;
        }
        while at < end { s1 += data[at].(u32); s2 += s1; at += 1; }
        s1 = s1 % 65521;
        s2 = s2 % 65521;
        remaining -= block_len;
        block_len = 5552;
    }
    ((s2 << 16) | s1).(i64)
}

